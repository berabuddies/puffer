# Momo frontend env. Copy to .env before running: cp .env.example .env

# WorldRouter Auth Station — REQUIRED for login.
# If this is missing the Sign-in button silently does nothing (console.error only).
VITE_AUTH_STATION_URL=https://auth.worldrouter.ai

# Everything below has a built-in default and is only needed to override it:
# VITE_WORLDROUTER_CONTROL_URL=https://control-api.worldrouter.ai   # JWT -> worldrouter key exchange host
# VITE_PUFFER_WS_URL=ws://127.0.0.1:1431/ws                         # frontend <-> Momo backend WS
# VITE_BACKEND_BASE_URL=http://127.0.0.1:8080                       # U-card wallet REST base
# VITE_USE_MOCK_WALLET=1                                            # wallet/KYC mock toggle
