# Momo frontend env. Copy to .env before running: cp .env.example .env

# WorldRouter Auth Station — REQUIRED for login.
# If this is missing the Sign-in button silently does nothing (console.error only).
VITE_AUTH_STATION_URL=https://auth.worldrouter.ai

# Everything below has a built-in default and is only needed to override it:
# VITE_WORLDROUTER_CONTROL_URL=https://control-api.worldrouter.ai   # JWT -> worldrouter key exchange + billing host
# VITE_WR_DASHBOARD_URL=https://www.worldrouter.ai                  # "Credits" pill -> /dashboard/credits top-up page
# VITE_PUFFER_WS_URL=ws://127.0.0.1:1431/ws                         # frontend <-> Momo backend WS
# U-card wallet REST base. In dev, Vite proxies /api here (dodges the backend
# CORS allowlist, which only admits the packaged tauri://localhost origin).
# Omit to use the local backend at http://127.0.0.1:8080.
# VITE_BACKEND_BASE_URL=https://ucard-test.tomo.services            # test env
# VITE_USE_MOCK_WALLET=1                                            # wallet/KYC mock toggle
